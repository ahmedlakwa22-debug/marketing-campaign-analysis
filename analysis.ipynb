    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv(\"C:\\\\Users\\\\lenovo\\\\Downloads\\\\WA_Marketing-Campaign\\\\WA_Marketing-Campaign.csv\")\n",
    "\n",
    "location_sales = df.groupby('LocationID')['SalesInThousands'].mean().reset_index()\n",
    "\n",
    "top_locations = location_sales.sort_values(by='SalesInThousands', ascending=False).head(20)\n",
    "\n",
    "sorted_locations = top_locations.sort_values(by='SalesInThousands', ascending=True).reset_index(drop=True)\n",
    "\n",
    "colors = sns.color_palette(\"Greys\", n_colors=256)\n",
    "gray_to_black = colors[100:]  
    "final_colors_sorted = gray_to_black[-len(sorted_locations):]\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.barplot(\n",
    "    x='SalesInThousands',\n",
    "    y='LocationID',\n",
    "    data=sorted_locations,\n",
    "    palette=final_colors_sorted\n",
    ")\n",
    "\n",
    "plt.title(\"Top 20 Locations by Average Sales (Sorted from Low to High)\")\n",
    "plt.xlabel(\"Average Sales in Thousands\")\n",
    "plt.ylabel(\"Location ID\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
