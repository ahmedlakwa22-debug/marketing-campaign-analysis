    "\n",
    "def categorize_age(age):\n",
    "    if age <= 5:\n",
    "        return 'New'\n",
    "    elif age <= 10:\n",
    "        return 'Mid-Age'\n",
    "    else:\n",
    "        return 'Old'\n",
    "\n",
    "df['StoreAgeCategory'] = df['AgeOfStore'].apply(categorize_age)\n",
    "\n",
    "avg_sales_age = df.groupby(['StoreAgeCategory', 'Promotion'])['SalesInThousands'].mean().reset_index()\n",
    "\n",
    "palette = {1: 'gray', 2: 'blue', 3: 'black'}\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.barplot(\n",
    "    x='StoreAgeCategory',\n",
    "    y='SalesInThousands',\n",
    "    hue='Promotion',\n",
    "    data=avg_sales_age,\n",
    "    palette=palette\n",
    ")\n",
    "\n",
    "plt.title(\"Average Sales by Promotion Type across Store Age Categories\")\n",
    "plt.xlabel(\"Store Age Category\")\n",
    "plt.ylabel(\"Average Sales in Thousands\")\n",
    "plt.legend(title='Promotion Type')\n",
    "\n",
