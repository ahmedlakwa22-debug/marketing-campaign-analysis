    "import pandas as pd\n",
    "from scipy.stats import f_oneway\n",
    "\n",
    "file_path = \"C:\\\\Users\\\\lenovo\\\\Downloads\\\\WA_Marketing-Campaign\\\\WA_Marketing-Campaign.csv\"\n",
    "df = pd.read_csv(file_path)\n",
    "\n",
    "sales_promo_1 = df[df['Promotion'] == 1]['SalesInThousands']\n",
    "sales_promo_2 = df[df['Promotion'] == 2]['SalesInThousands']\n",
    "sales_promo_3 = df[df['Promotion'] == 3]['SalesInThousands']\n",
    "\n",
    "f_stat, p_value = f_oneway(sales_promo_1, sales_promo_2, sales_promo_3)\n",
    "\n",
    "f_stat, p_value\n"
   ]
