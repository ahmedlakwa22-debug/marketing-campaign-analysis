   "source": [
    "\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "market_size_mapping = {'Small': 1, 'Medium': 2, 'Large': 3}\n",
    "df['MarketSizeNum'] = df['MarketSize'].map(market_size_mapping)\n",
    "\n",
    "features = df.groupby('LocationID').agg({\n",
    "    'SalesInThousands': 'mean',\n",
    "    'AgeOfStore': 'mean',\n",
    "    'Promotion': 'mean',\n",
    "    'MarketSizeNum': 'mean'\n",
    "}).reset_index()\n",
    "\n",
    "scaler = StandardScaler()\n",
    "scaled_features = scaler.fit_transform(features[['SalesInThousands', 'AgeOfStore', 'Promotion', 'MarketSizeNum']])\n",
    "\n",
    "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
    "features['Cluster'] = kmeans.fit_predict(scaled_features)\n",
    "\n",
    "cluster_summary = features.groupby('Cluster').mean().reset_index()\n",
    "\n",
    "import ace_tools as tools; tools.display_dataframe_to_user(name=\"Cluster Summary\", dataframe=cluster_summary)\n"
   ]
  },
